  "app": "Notion",
  "what_it_does": "Notion is a workspace app for notes, docs, wikis, and databases, and its REST API lets external apps read, create, and update pages, databases, users, and comments in a workspace.",
  "auth_methods": [
   "OAuth2",
   "Bearer token"
  ],
  "auth_primary": "OAuth2",
  "auth_notes": "Notion has three connection types: internal connections (static 'installation access token', single workspace), public connections (OAuth 2.0, installable across workspaces, can be Marketplace-listed), and personal access tokens (user-scoped static bearer token, no OAuth flow). All three authenticate API requests with a Bearer token in the Authorization header. A multi-user agent toolkit would use the public connection OAuth2 flow so each end user can individually authorize and pick which pages/databases to share.",
  "access": "self_serve_free",
  "access_notes": "Any developer can create an internal connection in the Developer portal and get a working API token immediately at no cost, or create a public (OAuth2) connection and use it without listing it on the Marketplace. Listing on the Notion Marketplace requires a Notion security review, but that review is only needed for public marketplace distribution, not for building or using the API.",
  "api_style": [
   "REST"
  ],
  "api_breadth": "broad",
  "api_docs_url": "https://developers.notion.com/reference/intro",
  "openapi_spec": true,
  "webhooks": true,
  "official_mcp": "official",
  "mcp_url": "https://mcp.notion.com/mcp",
  "buildability": "ready_with_caveats",
  "main_blocker": "Public (Marketplace) distribution requires Notion security review; official MCP server only supports user OAuth, not headless bearer-token auth",
